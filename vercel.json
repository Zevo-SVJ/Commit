{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/decision.ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/probe",
      "destination": "/api/health?probe=1"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
