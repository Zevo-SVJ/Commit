# Lock talks to one model provider, server-side only. No key ever reaches the
# browser, and CI fails the build if one appears in the client bundle.
#
# The provider is OpenRouter unless LOCK_PROVIDER explicitly says otherwise.
# Nothing is chosen by "whichever key happens to be set".

# --- OpenRouter (required) --------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Two concrete free models are tried in order by default:
#   1. openai/gpt-oss-120b:free            (enforces a JSON schema)
#   2. meta-llama/llama-3.3-70b-instruct:free  (JSON object + validator)
# Deliberately not openrouter/free: that router can select a content-safety
# classifier, which answers "User Safety: safe" instead of a decision.
# LOCK_MODEL pins one model outright and disables the fallback.
# LOCK_MODEL=openai/gpt-oss-120b:free
# LOCK_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct:free
# Force how JSON is asked for: json_schema | json_object | none
# LOCK_MODEL_FORMAT=json_object

# Optional attribution, shown on OpenRouter's rankings. Neither is required.
# LOCK_SITE_URL=https://your-deployment.example
# LOCK_SITE_NAME=Lock

# --- Legacy providers (opt-in only) -----------------------------------------
# Reachable only by naming one in LOCK_PROVIDER: openrouter | openai | gemini
# LOCK_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# --- Endpoints --------------------------------------------------------------
# Point at a gateway or regional endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
