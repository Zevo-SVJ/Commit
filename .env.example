# Lock talks to one model provider, server-side only. No key ever reaches the
# browser, and CI fails the build if one appears in the client bundle.
#
# The provider is OpenRouter unless LOCK_PROVIDER explicitly says otherwise.
# Nothing is chosen by "whichever key happens to be set".

# --- OpenRouter (required) --------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. By default the model is resolved at runtime from the catalogue your
# key can see: free, general-purpose, able to be asked for JSON, best first —
# google/gemma-4-31b-it:free, then z-ai/glm-5.2:free. Routers and coding /
# safety / embedding / audio models are excluded by name.
# Setting LOCK_MODEL pins one model and skips resolution entirely.
# LOCK_MODEL=google/gemma-4-31b-it:free
# LOCK_MODEL_FALLBACK=z-ai/glm-5.2:free
# Force how JSON is asked for: json_schema | json_object | none
# LOCK_MODEL_FORMAT=json_object

# Optional attribution, shown on OpenRouter's rankings. Neither is required.
# LOCK_SITE_URL=https://your-deployment.example
# LOCK_SITE_NAME=Lock

# --- Legacy providers (opt-in only) -----------------------------------------
# Reachable only by naming one in LOCK_PROVIDER: openrouter | openai | gemini
# LOCK_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# --- Endpoints --------------------------------------------------------------
# Point at a gateway or regional endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- The verdict endpoint ---------------------------------------------------
# /api/verdict is same-origin only unless origins are named here. Lock's own
# frontend needs nothing; this is for other callers of the public contract.
# LOCK_ALLOWED_ORIGINS=https://example.com
