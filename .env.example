# Lock needs one secret. It is read on the server only and is never sent to,
# bundled into, or reachable from the browser.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4.1.
# LOCK_MODEL=gpt-4.1

# Optional. Point at a compatible gateway or a regional endpoint.
# LOCK_BASE_URL is not used; the provider reads OPENAI_BASE_URL.
# OPENAI_BASE_URL=https://api.openai.com/v1
