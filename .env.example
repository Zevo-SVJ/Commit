# Lock talks to one model provider, server-side only. No key ever reaches the
# browser, and CI fails the build if one appears in the client bundle.
#
# Whichever key is present decides the provider — Gemini first — unless
# LOCK_PROVIDER says otherwise.

# --- Google Gemini (has a free tier) ---------------------------------------
GEMINI_API_KEY=AIza...
# Optional. Defaults to gemini-2.5-flash. Open /probe to see which models your
# key can actually use, and set this to one of them.
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ----------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# LOCK_MODEL=gpt-4.1

# --- Overrides -------------------------------------------------------------
# Force a provider regardless of which keys are set: openai | gemini
# LOCK_PROVIDER=gemini
# Point at a gateway or regional endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
